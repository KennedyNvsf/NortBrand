# Copy to .env.local and fill in. Never commit real values.
# Validated by src/env.ts; `next dev` and `next build` fail if any are missing.

# --- Public (inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: leave empty to run without Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
NOTIFY_TO_EMAIL=
IP_HASH_SALT=
NEWSLETTER_TOKEN_SECRET=

# --- Build only (Vercel): uploads source maps to Sentry. Optional locally. ---
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
